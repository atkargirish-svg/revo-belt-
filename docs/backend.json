
{
  "entities": {
    "SensorReading": {
      "title": "SensorReading",
      "description": "Real-time telemetry from NodeMCU sensors",
      "type": "object",
      "properties": {
        "vibration": { "type": "number" },
        "temperature": { "type": "number" },
        "speed": { "type": "number" },
        "alignment": { "type": "number" },
        "health": { "type": "number" },
        "sectionId": { "type": "string" },
        "sectionName": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["vibration", "temperature", "speed", "alignment", "health", "timestamp"]
    },
    "SystemStatus": {
      "title": "SystemStatus",
      "description": "Operational state and hardware alarm control",
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["online", "offline"] },
        "deviceId": { "type": "string" },
        "firmwareVersion": { "type": "string" },
        "alarm": { "type": "boolean" },
        "lastSeen": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/current": {
      "schema": "SensorReading",
      "description": "Latest sensor state for the conveyor"
    },
    "/system": {
      "schema": "SystemStatus",
      "description": "Global system status and hardware controls"
    }
  }
}
